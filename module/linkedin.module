#!name=LinkedIn 去广告
#!desc=移除 LinkedIn 首页信息流中的 Promoted（推广）帖子
#!category=Self

[MITM]
hostname = %APPEND% www.linkedin.com

[Script]
linkedin_ads = type=http-response,pattern=^https:\/\/www\.linkedin\.com\/sdui\/flagship\/(?:screenApi\/getScreen|pageApi\/getPage)\?sduiid=com\.linkedin\.sdui\.(?:flagshipnav\.feed\.MainFeed|pagers\.feed\.mainFeed)(?:&.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/isinglever/adguard/main/js/linkedin_ads.js,timeout=60,script-update-interval=0
