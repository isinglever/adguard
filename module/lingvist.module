#!name=Lingvist
#!desc=Client-side Unlimited status, course unlock, and new-card queue priority.
#!category=Self

[MITM]
hostname = %APPEND% payment-api.lingvist.com, api.lingvist.com, api.adapty.io

[Script]
sync = type=http-response,pattern=^https?:\/\/api\.lingvist\.com\/\d+(?:\.\d+)?\/user\/sync(?:[?#].*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/isinglever/adguard/main/js/lingvist/lingvist_sync.js?v=20260823-2,timeout=60,script-update-interval=0
services = type=http-response,pattern=^https?:\/\/payment-api\.lingvist\.com\/\d+(?:\.\d+)?\/user\/services(?:[?#].*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/isinglever/adguard/main/js/lingvist/lingvist_services.js?v=20260823-2,timeout=60,script-update-interval=0
course_request = type=http-request,pattern=^https?:\/\/api\.lingvist\.com\/\d+(?:\.\d+)?\/courses\/[0-9a-fA-F-]{36}(?:[?#].*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/isinglever/adguard/main/js/lingvist/lingvist_course_request.js?v=20260823-2,timeout=60,script-update-interval=0
course_response = type=http-response,pattern=^https?:\/\/api\.lingvist\.com\/\d+(?:\.\d+)?\/courses(?:\/[0-9a-fA-F-]{36})?(?:[?#].*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/isinglever/adguard/main/js/lingvist/lingvist_course_response.js?v=20260823-2,timeout=60,script-update-interval=0
validate = type=http-response,pattern=^https?:\/\/api\.adapty\.io\/api\/v\d+\/sdk\/purchase\/app-store\/original-transaction-id\/validate\/?(?:[?#].*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/isinglever/adguard/main/js/lingvist/lingvist_validate.js,timeout=60,script-update-interval=0
